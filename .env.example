# --- Messaging: "sim" (local terminal simulator) or "spectrum" (real iMessage via Photon)
MESSENGER=sim
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Only set if Photon gives us a dedicated line: invites become sms: links to this number.
BOT_PHONE=

# --- AI (receipts + message understanding). Without a key, Tab falls back to keyword parsing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Solana: "mock" (no network) or "devnet". Run `npm run solana:setup` for the devnet values.
SOLANA_MODE=mock
SOLANA_RPC_URL=https://api.devnet.solana.com
TAB_TREASURY_SECRET=
TAB_USDC_MINT=
TAB_MASTER_KEY=
STARTING_BALANCE_CENTS=50000

# --- App
BOT_NAME=Tab
PORT=3000
# Public URL of this server (use an ngrok/cloudflared URL so phones can open invite + trip links)
PUBLIC_URL=http://localhost:3000
DB_PATH=data/tab.db
# Demo mode shortens timers: auto-approve 5 min, reminders 3 min, jobs every 30s
DEMO_MODE=1
AUTO_APPROVE_MINUTES=
REMINDER_GAP_MINUTES=
JOB_INTERVAL_SECONDS=
